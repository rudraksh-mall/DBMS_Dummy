# ------------------------------------------------------------------
# CivicFix AI — backend environment example
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ------------------------------------------------------------------

# --- Server ---
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- MySQL (hosted; e.g. Aiven) ---
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-with-secret
MYSQL_DATABASE=civicfix
# Enforce TLS. If your provider requires its CA, point MYSQL_CA_PATH at it.
MYSQL_SSL=true
MYSQL_CA_PATH=./certs/ca.pem
MYSQL_POOL_SIZE=10
MYSQL_CONNECT_TIMEOUT=20000

# --- Test / seed safety ---
# Automated tests run against this isolated database.
MYSQL_TEST_DATABASE=civicfix_test
# Extra database names the seed is allowed to touch (comma separated).
# The demo seed refuses to run against anything that is not clearly a
# dev/test/demo database.
SEED_ALLOWED_DATABASES=

# --- Auth ---
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRY=1d

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Email (OTP delivery) ---
EMAIL_USER=
EMAIL_PASS=

# --- Cloudinary (complaint images) ---
CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

# --- OpenAI (complaint classification) ---
OPENAI_API_KEY=
