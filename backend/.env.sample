# Legacy sample name kept for compatibility.
# See `.env.example` for the authoritative, documented list of variables.
# Copy it to `.env` and fill in real values. NEVER commit the real `.env`.

PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=civicfix
MYSQL_SSL=true
MYSQL_CA_PATH=./certs/ca.pem

MYSQL_TEST_DATABASE=civicfix_test
SEED_ALLOWED_DATABASES=

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d

GOOGLE_CLIENT_ID=
EMAIL_USER=
EMAIL_PASS=

CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

OPENAI_API_KEY=
